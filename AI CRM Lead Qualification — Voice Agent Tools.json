        "jsCode": "const item = $json;\nlet base;\nconst d = String(item.date || '');\nif (/\\d{4}-\\d{2}-\\d{2}/.test(d)) {\n  base = d.slice(0, 10);\n} else {\n  base = new Date(Date.now() + 86400000).toISOString().slice(0, 10);\n}\nconst slots = [base + 'T10:00', base + 'T14:30', base + 'T16:00'];\nconst payload = { slots: slots };\nreturn { results: [{ toolCallId: item.toolCallId, result: JSON.stringify(payload) }] };"
