    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $json;\nconst parseBudget = (v) => {\n  if (v == null || v === '') return 0;\n  if (typeof v === 'number') return v;\n  const s = String(v).toLowerCase().replace(/[$,\\s]/g, '');\n  const km = s.match(/([0-9]*\\.?[0-9]+)\\s*k/);\n  if (km) return Math.round(parseFloat(km[1]) * 1000);\n  const m = s.match(/[0-9]*\\.?[0-9]+/);\n  return m ? parseFloat(m[0]) : 0;\n};\nconst parseTimelineMonths = (v) => {\n  if (v == null || v === '') return 999;\n  const s = String(v).toLowerCase();\n  if (/(asap|immediat|right now|now|today|this week|next week|urgent)/.test(s)) return 0.5;\n  let m;\n  m = s.match(/([0-9]*\\.?[0-9]+)\\s*(year|yr)/); if (m) return parseFloat(m[1]) * 12;\n  m = s.match(/([0-9]*\\.?[0-9]+)\\s*(month|mo)/); if (m) return parseFloat(m[1]);\n  m = s.match(/([0-9]*\\.?[0-9]+)\\s*(week|wk)/); if (m) return parseFloat(m[1]) / 4.345;\n  m = s.match(/([0-9]*\\.?[0-9]+)\\s*(day)/); if (m) return parseFloat(m[1]) / 30;\n  m = s.match(/[0-9]*\\.?[0-9]+/); if (m) return parseFloat(m[0]);\n  return 999;\n};\nconst budget = parseBudget(item.budget);\nconst months = parseTimelineMonths(item.timeline);\nlet score = 'Low';\nif (budget >= 5000 && months <= 3) score = 'High';\nelse if (budget >= 2000) score = 'Medium';\nconst qualified = score === 'High' || score === 'Medium';\nconst payload = { lead_score: score, qualified: qualified, budget_parsed: budget, timeline_months: Math.round(months * 100) / 100 };\nreturn { results: [{ toolCallId: item.toolCallId, result: JSON.stringify(payload) }] };"
      },
