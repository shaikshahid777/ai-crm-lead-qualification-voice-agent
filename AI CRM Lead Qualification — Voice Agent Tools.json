      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const root = $json.body || $json;\nlet name = '';\nlet toolCallId = '';\nlet args = {};\ntry {\n  if (root && root.message && Array.isArray(root.message.toolCalls) && root.message.toolCalls.length) {\n    const tc = root.message.toolCalls[0];\n    toolCallId = tc.id || '';\n    name = (tc.function && tc.function.name) || '';\n    let a = tc.function && tc.function.arguments;\n    if (typeof a === 'string') { try { a = JSON.parse(a); } catch (e) { a = {}; } }\n    args = a || {};\n  } else if (root && root.function) {\n    name = root.function.name || '';\n    let a = root.function.arguments;\n    if (typeof a === 'string') { try { a = JSON.parse(a); } catch (e) { a = {}; } }\n    args = a || {};\n    toolCallId = root.id || '';\n  } else {\n    name = root.function_name || root.functionName || root.name || '';\n    args = root.arguments || root.args || root || {};\n    toolCallId = root.toolCallId || root.tool_call_id || '';\n  }\n} catch (e) { args = {}; }\nconst g = (k) => (args && args[k] != null ? args[k] : '');\nreturn {\n  functionName: name,\n  toolCallId: toolCallId,\n  budget: g('budget'),\n  authority: g('authority'),\n  need: g('need'),\n  timeline: g('timeline'),\n  name: g('name'),\n  email: g('email'),\n  company: g('company'),\n  lead_score: g('lead_score'),\n  lead_id: g('lead_id'),\n  date: g('date'),\n  selected_slot: g('selected_slot'),\n  meeting_id: g('meeting_id'),\n};"
